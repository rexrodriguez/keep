# SHARP geometric measurement server URL
# Start the Python server in packages/sharp-server, then set this:
SHARP_SERVER_URL=http://localhost:8000

# SMTP Configuration for contact form emails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
CONTACT_EMAIL=xxxx@keep.storage
